{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-secrets-access.js Read {{args.file_path}}"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-secrets-access.js Grep {{args.path}}"
          }
        ]
      }
    ]
  }
}
